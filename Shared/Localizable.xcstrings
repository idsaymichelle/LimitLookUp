    "Limits of the chosen account. Touch and hold the widget to choose an account.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиты выбранного аккаунта. Удерживайте виджет, чтобы выбрать аккаунт."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所選帳號的限額。按住小工具即可選擇帳號。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所选账号的限额。按住小组件即可选择账号。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites de la cuenta elegida. Mantén pulsado el widget para elegir una cuenta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 계정의 한도입니다. 위젯을 길게 눌러 계정을 선택하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدود الحساب المختار. المس الأداة مطولًا لاختيار حساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits des gewählten Accounts. Widget gedrückt halten, um ein Account zu wählen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti dell'account scelto. Tieni premuto il widget per scegliere un account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites du compte choisi. Maintenez le widget appuyé pour choisir un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアカウントの上限です。ウィジェットを長押ししてアカウントを選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
