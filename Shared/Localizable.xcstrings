    "LimitLookUp": {
      "shouldTranslate": false
    },
    "LimitLookUp has no server of its own. Limits are requested only from the sites of the services you add and are stored on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У LimitLookUp нет своего сервера. Лимиты запрашиваются только у сайтов добавленных сервисов и хранятся на этом устройстве."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 沒有自己的伺服器。限額只會向你新增的服務網站請求，並儲存在此裝置上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 没有自己的服务器。限额只会向你添加的服务网站请求，并保存在此设备上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp no tiene servidor propio. Los límites se solicitan solo a los sitios de los servicios que añadas y se guardan en este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp에는 자체 서버가 없습니다. 한도는 추가한 서비스의 사이트에만 요청하며 이 기기에 저장됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك LimitLookUp خادمًا خاصًا. تُطلب الحدود من مواقع الخدمات التي تضيفها فقط وتُخزَّن على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp hat keinen eigenen Server. Limits werden nur bei den Websites der hinzugefügten Dienste abgefragt und auf diesem Gerät gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp non ha un server proprio. I limiti vengono richiesti solo ai siti dei servizi che aggiungi e restano su questo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp n'a pas de serveur. Les limites sont demandées uniquement aux sites des services que vous ajoutez et restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp には独自のサーバーがありません。上限は追加したサービスのサイトにのみ問い合わせ、このデバイスに保存されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp has no server of its own. Limits are requested only from the sites of the services you add and are stored on this device."
          }
        }
      }
    },
    "LimitLookUp needs notifications to warn you about limits and resets. iOS won’t ask again, so turn them on in Settings:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp нужны уведомления, чтобы предупреждать о лимитах и сбросах. iOS больше не спросит, поэтому включите их в Настройках:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 需要通知才能提醒你限額與重設。iOS 不會再次詢問，請在「設定」中開啟："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 需要通知才能提醒你限额和重置。iOS 不会再次询问，请在“设置”中开启："
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp necesita notificaciones para avisarte de límites y restablecimientos. iOS no volverá a preguntar, así que actívalas en Ajustes:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp이 한도와 초기화를 알리려면 알림이 필요합니다. iOS는 다시 묻지 않으니 설정에서 켜 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج LimitLookUp إلى الإشعارات لتنبيهك بالحدود وإعادة التعيين. لن يسألك iOS مجددًا، لذا شغّلها من الإعدادات:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp braucht Mitteilungen, um dich vor Limits und Zurücksetzungen zu warnen. iOS fragt nicht noch einmal, also schalte sie in den Einstellungen ein:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp ha bisogno delle notifiche per avvisarti su limiti e azzeramenti. iOS non lo chiederà di nuovo, quindi attivale in Impostazioni:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp a besoin des notifications pour vous prévenir des limites et réinitialisations. iOS ne redemandera pas, activez-les dans Réglages :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp は上限とリセットを知らせるために通知が必要です。iOS は再度確認しないので、設定でオンにしてください："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp needs notifications to warn you about limits and resets. iOS won’t ask again, so turn them on in Settings:"
          }
        }
      }
    },
    "LimitLookUp warns you before a limit runs out and tells you when it resets. iOS will now ask for permission: tap “Allow”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp предупредит, когда лимит почти закончится, и сообщит, когда он сбросится. Сейчас iOS спросит разрешение — нажмите «Разрешить»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 會在限額快用完前提醒你，並在重設時通知你。iOS 現在會請求權限：請點選「允許」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp 会在限额快用完前提醒你，并在重置时通知你。iOS 现在会请求权限：请点按“允许”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp te avisa antes de que se agote un límite y cuando se restablece. iOS te pedirá permiso ahora: toca «Permitir»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp은 한도가 소진되기 전에 알려 주고 초기화되면 알려 줍니다. 이제 iOS가 권한을 요청합니다. ‘허용’을 누르세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبهك LimitLookUp قبل نفاد الحد ويخبرك عند إعادة تعيينه. سيطلب iOS الإذن الآن: اضغط «السماح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp warnt dich, bevor ein Limit aufgebraucht ist, und meldet, wenn es zurückgesetzt wird. iOS fragt jetzt nach der Erlaubnis: Tippe auf „Erlauben“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp ti avvisa prima che un limite finisca e quando si azzera. Ora iOS chiederà il permesso: tocca «Consenti»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp vous prévient avant qu'une limite soit atteinte et quand elle se réinitialise. iOS va demander l'autorisation : touchez « Autoriser »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp は上限がなくなる前に知らせ、リセットされたときにも通知します。iOS が許可を求めるので「許可」をタップしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitLookUp warns you before a limit runs out and tells you when it resets. iOS will now ask for permission: tap “Allow”."
          }
        }
      }
    },
