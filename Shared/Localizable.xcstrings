    "Sign-in wasn’t finished. Choose the service again to sign in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не завершён. Выберите сервис ещё раз, чтобы войти."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入未完成。請再次選擇服務以登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录未完成。请再次选择服务以登录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión. Elige el servicio de nuevo para iniciar sesión."
