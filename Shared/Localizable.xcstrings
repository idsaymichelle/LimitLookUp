    "%@ is available again ahead of schedule.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ снова доступен раньше срока."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已提前恢復可用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已提前恢复可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a estar disponible antes de lo previsto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 한도가 예정보다 일찍 다시 사용 가능해졌습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح %@ متاحًا مجددًا قبل الموعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist früher als geplant wieder verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è di nuovo disponibile in anticipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est de nouveau disponible plus tôt que prévu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が予定より早く再び使えるようになりました。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available again ahead of schedule."
          }
        }
      }
    },
