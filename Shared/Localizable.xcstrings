    "An early reset is when a service restores a limit before the announced time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Досрочный сброс — когда сервис восстанавливает лимит раньше объявленного времени."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提前重設是指服務在公告時間前恢復限額。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前重置是指服务在公布时间之前恢复限额。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un restablecimiento anticipado ocurre cuando un servicio repone un límite antes de la hora anunciada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조기 초기화는 서비스가 안내된 시간보다 먼저 한도를 복구하는 것입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة التعيين المبكرة هي عندما تستعيد الخدمة الحد قبل الموعد المعلن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vorzeitige Zurücksetzung liegt vor, wenn ein Dienst ein Limit vor der angekündigten Zeit wiederherstellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un azzeramento anticipato avviene quando un servizio ripristina un limite prima dell'orario annunciato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réinitialisation anticipée a lieu quand un service rétablit une limite avant l'heure annoncée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早期リセットとは、サービスが予定時刻より前に上限を回復することです。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An early reset is when a service restores a limit before the announced time."
          }
        }
      }
    },
