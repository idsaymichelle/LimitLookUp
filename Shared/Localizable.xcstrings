          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con Apple. Puedes continuar sin iniciar sesión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인하지 못했습니다. 로그인 없이 계속할 수 있습니다."
