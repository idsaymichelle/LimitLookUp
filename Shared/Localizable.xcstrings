    },
    "If the main Settings page opens, scroll down and open “Apps”, then “LimitLookUp”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если открылась главная страница Настроек, пролистайте вниз и откройте «Приложения», затем «LimitLookUp»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果開啟的是「設定」主頁，請向下捲動並打開「App」，然後點選「LimitLookUp」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果打开的是“设置”主页，请向下滚动并打开“App”，然后点按“LimitLookUp”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se abre la página principal de Ajustes, desplázate hacia abajo y abre «Apps» y luego «LimitLookUp»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 메인 화면이 열리면 아래로 스크롤해 ‘앱’을 열고 ‘LimitLookUp’을 누르세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فُتحت صفحة الإعدادات الرئيسية، فمرّر لأسفل وافتح «التطبيقات» ثم «LimitLookUp»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Hauptseite der Einstellungen erscheint, scrolle nach unten, öffne „Apps“ und dann „LimitLookUp“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si apre la pagina principale di Impostazioni, scorri in basso e apri «App», poi «LimitLookUp»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la page principale de Réglages s’ouvre, faites défiler, ouvrez « Apps », puis « LimitLookUp »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定のトップページが開いたら、下にスクロールして「アプリ」を開き、「LimitLookUp」をタップします。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the main Settings page opens, scroll down and open “Apps”, then “LimitLookUp”."
          }
        }
      }
    },
