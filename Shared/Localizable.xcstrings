    "No internet connection. Limits will update when you’re back online.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет интернета. Лимиты обновятся, когда сеть появится."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有網路連線。恢復連線後會更新限額。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接。恢复联网后将更新限额。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Los límites se actualizarán cuando vuelvas a estar en línea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결되어 있지 않습니다. 다시 연결되면 한도가 업데이트됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت. سيتم تحديث الحدود عند عودة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Die Limits werden aktualisiert, sobald du wieder online bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a internet. I limiti si aggiorneranno quando tornerai online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion internet. Les limites seront mises à jour une fois reconnecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続されていません。接続が戻ると上限が更新されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Limits will update when you’re back online."
          }
        }
      }
    },
