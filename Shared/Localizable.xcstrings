    "Sign in with Apple to keep your name and email in the app. They stay on this device and are never sent anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через Apple, чтобы сохранить имя и почту в приложении. Они остаются на этом устройстве и никуда не отправляются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入，即可在 App 中保存你的姓名與電子郵件。這些資料只保留在此裝置上，絕不會傳送到任何地方。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录，即可在 App 中保存你的姓名和电子邮件。这些信息只保留在此设备上，绝不会发送到任何地方。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para guardar tu nombre y correo en la app. Se quedan en este dispositivo y nunca se envían a ningún sitio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인하면 이름과 이메일이 앱에 저장됩니다. 이 정보는 이 기기에만 남고 어디에도 전송되지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام Apple لحفظ اسمك وبريدك في التطبيق. يبقيان على هذا الجهاز ولا يُرسلان إلى أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, um Name und E-Mail in der App zu speichern. Sie bleiben auf diesem Gerät und werden nirgendwohin gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple per salvare nome ed e-mail nell'app. Restano su questo dispositivo e non vengono mai inviati altrove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour garder votre nom et votre e-mail dans l'app. Ils restent sur cet appareil et ne sont jamais envoyés ailleurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインすると、名前とメールがアプリに保存されます。これらはこのデバイスにのみ保存され、どこにも送信されません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple to keep your name and email in the app. They stay on this device and are never sent anywhere."
          }
        }
      }
    },
    "Sign in with Apple to start. LimitLookUp gets only your name and email, and they stay on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать, войдите через Apple. LimitLookUp получает только имя и почту, и они остаются на этом устройстве."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 登入即可開始。LimitLookUp 只會取得你的姓名與電子郵件，並保留在此裝置上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录即可开始。LimitLookUp 只会获取你的姓名和电子邮件，并保留在此设备上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple para empezar. LimitLookUp solo recibe tu nombre y correo, y se quedan en este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 Apple로 로그인하세요. LimitLookUp은 이름과 이메일만 받으며 이 정보는 이 기기에만 남습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام Apple للبدء. يحصل LimitLookUp على اسمك وبريدك فقط، ويبقيان على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Apple an, um zu starten. LimitLookUp erhält nur Name und E-Mail, und sie bleiben auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple per iniziare. LimitLookUp riceve solo nome ed e-mail, che restano su questo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple pour commencer. LimitLookUp ne reçoit que votre nom et votre e-mail, qui restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインして始めましょう。LimitLookUp が受け取るのは名前とメールだけで、このデバイスにのみ保存されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple to start. LimitLookUp gets only your name and email, and they stay on this device."
          }
        }
      }
    },
    "Sign in with email. Google doesn’t allow its sign-in inside apps.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входите по почте: Google не разрешает входить через него внутри приложений."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用電子郵件登入：Google 不允許在 App 內使用其登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用电子邮件登录：Google 不允许在 App 内使用其登录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu correo: Google no permite su inicio de sesión dentro de apps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일로 로그인하세요. Google은 앱 내부 로그인을 허용하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بالبريد الإلكتروني: لا تسمح Google بتسجيل الدخول داخل التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich per E-Mail an: Google erlaubt seine Anmeldung nicht in Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con l'e-mail: Google non consente il suo accesso all'interno delle app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous par e-mail : Google n’autorise pas sa connexion dans les apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールでサインインしてください。Google はアプリ内でのサインインを許可していません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with email. Google doesn’t allow its sign-in inside apps."
          }
        }
      }
    },
