    "Couldn’t get your limits. Pull down to try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить лимиты. Потяните экран вниз, чтобы повторить."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得限額。向下拉以重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取限额。下拉以重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron obtener tus límites. Desliza hacia abajo para reintentar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도를 가져오지 못했습니다. 아래로 당겨 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر جلب حدودك. اسحب لأسفل للمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits konnten nicht geladen werden. Zum Wiederholen nach unten ziehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ottenere i limiti. Trascina verso il basso per riprovare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir vos limites. Tirez vers le bas pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を取得できませんでした。下に引いて再試行してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t get your limits. Pull down to try again."
          }
        }
      }
    },
    "Couldn’t sign in with Apple. Check your internet connection and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Apple. Проверьте подключение к интернету и попробуйте ещё раз."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 Apple 登入。請檢查網路連線後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 Apple 登录。请检查网络连接后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con Apple. Revisa tu conexión a internet e inténtalo de nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسجيل الدخول باستخدام Apple. تحقق من اتصالك بالإنترنت وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden mit Apple hat nicht geklappt. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere con Apple. Controlla la connessione a internet e riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion avec Apple impossible. Vérifiez votre connexion internet et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインできませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign in with Apple. Check your internet connection and try again."
          }
        }
      }
    },
    "Couldn’t sign in with Apple. You can continue without signing in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Apple. Можно продолжить без входа."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 Apple 登入。你可以不登入繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
