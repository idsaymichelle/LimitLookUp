    "Last 30 days, from readings on your devices.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За последние 30 дней, по замерам на ваших устройствах."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 30 天，依據你各裝置的紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 30 天，基于你各设备的记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos 30 días, según las lecturas de tus dispositivos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30일, 내 기기들의 측정값 기준."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر 30 يومًا، من قراءات أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte 30 Tage, aus den Messwerten deiner Geräte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimi 30 giorni, dalle letture dei tuoi dispositivi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 derniers jours, d’après les relevés de vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 30 日間、お使いのデバイスの記録から。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 30 days, from readings on your devices."
          }
        }
      }
    },
