    "Which account to show. If none is chosen, the one closest to its limit is shown.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой аккаунт показывать. Если не выбран, показывается самый загруженный."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要顯示的帳號。若未選擇，會顯示最接近限額的帳號。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要显示的账号。若未选择，将显示最接近限额的账号。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué cuenta mostrar. Si no eliges ninguna, se muestra la más cercana a su límite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시할 계정입니다. 선택하지 않으면 한도에 가장 가까운 계정이 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحساب المراد عرضه. إذا لم تختر أي حساب، يُعرض الأقرب إلى حده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Account angezeigt wird. Ohne Auswahl wird das Account angezeigt, das seinem Limit am nächsten ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale account mostrare. Se non ne scegli uno, viene mostrato quello più vicino al limite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à afficher. Sans choix, celui le plus proche de sa limite est affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示するアカウント。選ばない場合は上限に最も近いアカウントが表示されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which account to show. If none is chosen, the one closest to its limit is shown."
          }
        }
      }
    },
