    "Add an account to see how much of your limits is left and when they reset.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте аккаунт, чтобы видеть, сколько лимита осталось и когда он сбросится."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增帳號，即可查看剩餘限額與重設時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加账号，即可查看剩余限额和重置时间。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una cuenta para ver cuánto te queda de tus límites y cuándo se restablecen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 추가하면 남은 한도와 초기화 시간을 볼 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف حسابًا لترى ما تبقى من حدودك ومتى تتم إعادة تعيينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Account hinzu, um zu sehen, wie viel von deinen Limits übrig ist und wann sie zurückgesetzt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un account per vedere quanto resta dei tuoi limiti e quando si azzerano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un compte pour voir ce qu'il reste de vos limites et quand elles se réinitialisent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを追加すると、上限の残りとリセット時刻を確認できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an account to see how much of your limits is left and when they reset."
          }
        }
      }
    },
