    "Only you see this name. It helps tell accounts of the same service apart.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название видно только вам и помогает отличать аккаунты одного сервиса."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你看得到這個名稱，方便區分同一服務的多個帳號。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能看到这个名称，便于区分同一服务的多个账号。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú ves este nombre. Ayuda a distinguir cuentas del mismo servicio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 나만 볼 수 있으며 같은 서비스의 계정을 구분하는 데 도움이 됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت فقط ترى هذا الاسم. يساعدك على التمييز بين حسابات الخدمة نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du siehst diesen Namen. Er hilft, Accounts desselben Dienstes zu unterscheiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu vedi questo nome. Aiuta a distinguere gli account dello stesso servizio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul voyez ce nom. Il aide à distinguer les comptes d'un même service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はあなたにだけ表示され、同じサービスのアカウントを見分けるのに役立ちます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you see this name. It helps tell accounts of the same service apart."
          }
        }
      }
    },
