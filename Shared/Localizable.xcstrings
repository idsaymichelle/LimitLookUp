          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qu'il reste de vos limites Claude Code et Codex et quand elles se réinitialisent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
